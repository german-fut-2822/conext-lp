---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import NosotrosCompleto from '../components/NosotrosCompleto.astro';
import Footer from '../components/Footer.astro';
---
<Layout title="Nosotros | CONEXT" titleKey="title.nosotros">
  <Header />
  <main>
    <PageHero
      eyebrow="Nosotros"
      eyebrowKey="nosotros.eyebrow"
      title="Nuestra trayectoria respalda cada operación"
      titleKey="nosotros.title"
      lead="Desde 1998, CONEXT es una empresa mexicana fundada en Monterrey, Nuevo León. Iniciamos comercializando metales no ferrosos y, con los años, crecimos hacia minerales, productos químicos industriales y fabricación de aleaciones, de la mano de Fundición Maxxima."
      leadKey="nosotros.lead"
      image="/assets/img/hero-nosotros.jpg"
      imagePosition="center 20%"
      imageAlt="Patio industrial en Monterrey con metal apilado al atardecer y el Cerro de la Silla de fondo, representando el origen y la trayectoria de CONEXT"
      imageAltEn="Industrial yard in Monterrey with stacked metal at sunset and Cerro de la Silla in the background, representing CONEXT's origins and track record"
    />
    <NosotrosCompleto />
  </main>
  <Footer />
</Layout>
