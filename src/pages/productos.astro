---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import Metales from '../components/Metales.astro';
import Quimicos from '../components/Quimicos.astro';
import Industrias from '../components/Industrias.astro';
import Footer from '../components/Footer.astro';
---
<Layout title="Productos | CONEXT" titleKey="title.productos">
  <Header />
  <main>
    <PageHero
      eyebrow="Productos"
      eyebrowKey="productos.page.heroEyebrow"
      title="Catálogo completo de metales no ferrosos y químicos industriales"
      titleKey="productos.page.heroTitle"
      lead="Comercialización con el respaldo y la consistencia que exigen las operaciones de gran volumen."
      leadKey="productos.page.heroLead"
      image="/assets/img/hero-productos.jpg"
      imageAlt="Almacén industrial con metales en lingote y contenedores de químicos listos para distribución"
    />
    <Metales />
    <Quimicos />
    <Industrias />
  </main>
  <Footer />
</Layout>
