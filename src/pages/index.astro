---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Solucion from '../components/Solucion.astro';
import Presencia from '../components/Presencia.astro';
import Metales from '../components/Metales.astro';
import Quimicos from '../components/Quimicos.astro';
import Industrias from '../components/Industrias.astro';
import Calidad from '../components/Calidad.astro';
import Maxxima from '../components/Maxxima.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
---
<Layout>
  <Header />
  <main class="home">
    <Hero />
    <Solucion />
    <Presencia home tightBottom />
    <Metales showEyebrow={false} home />
    <Industrias />
    <Quimicos showEyebrow={false} home />
    <Calidad />
    <Maxxima showEyebrow={false} condensed />
    <Contacto home />
  </main>
  <Footer />
</Layout>
