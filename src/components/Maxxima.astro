---
export interface Props {
  showEyebrow?: boolean;
  condensed?: boolean;
}
const { showEyebrow = true, condensed = false } = Astro.props;

// Logo de Maxxima (nota del Sites). Aún no lo tenemos: se muestra en cuanto se
// coloque el archivo en public/assets/img/maxxima/ con alguno de estos nombres.
// En el home, la foto Fundicion-Maxxima.jpg va de fondo de la sección (.maxxima.condensed).
import fs from 'node:fs';
import path from 'node:path';
const LOGO = ['logo-maxxima.svg', 'logo-maxxima.png', 'logo-maxxima.webp']
  .find((f) => fs.existsSync(path.join(process.cwd(), 'public/assets/img/maxxima', f)));
const STAT_ICONS = {
  clock: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>',
  flame: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.4-.5-2-1-3-1.1-2.1-.2-4 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.2.4-2.3 1-3a2.5 2.5 0 0 0 2.5 2.5Z"/></svg>',
  rotate: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-2.64-6.36"/><path d="M21 3v6h-6"/></svg>',
};
---
<section class:list={['maxxima tech-grid tech-grid-dark', { condensed }]} id="maxxima">
  <div class="container">
    <div class="maxxima-top">
      <div class="maxxima-intro">
        {showEyebrow && <span class="eyebrow reveal" data-i18n="maxxima.eyebrow">Empresa hermana</span>}
        {LOGO && <img src={`/assets/img/maxxima/${LOGO}`} alt="Fundición Maxxima" class="maxxima-logo reveal" />}
        {condensed && <span class="eyebrow reveal" data-i18n="maxxima.dividerLabel">Nuestra empresa hermana</span>}
        <h2 class="reveal">Fundición Maxxima</h2>
        {condensed ? (
          <p class="reveal" style="--d:1" data-i18n-es="Fundición Maxxima es nuestra empresa hermana, especializada en fundición y elaboración de aleaciones. Comparte con CONEXT el mismo compromiso de calidad y respaldo comercial." data-i18n-en="Fundición Maxxima is our sister company, specialized in smelting and alloy production. It shares CONEXT’s same commitment to quality and commercial backing.">Fundición Maxxima es nuestra empresa hermana, especializada en fundición y elaboración de aleaciones. Comparte con CONEXT el mismo compromiso de calidad y respaldo comercial.</p>
        ) : (
        <p class="reveal" style="--d:1" data-i18n="maxxima.body">Fundición Maxxima es una empresa mexicana con más de 15 años de experiencia en la fundición de metales no ferrosos y sus aleaciones —entre ellos Zinc, Aluminio, Antimonio y Plomo. Trabajamos bajo las especificaciones de cada cliente, incluyendo esquemas de maquila, y procesamos subproductos generados por la industria metalúrgica para la recuperación y aprovechamiento de sus metales.</p>
        )}
        {condensed && (
          <a href="/fundicion-maxxima" class="btn-ghost light reveal maxxima-home-cta" style="--d:2" data-i18n-es="Conocer más" data-i18n-en="Learn more">Conocer más</a>
        )}
      </div>
      {condensed && (
        <img src="/assets/img/logo_fondoMaxxima.webp" alt="Logotipo de Fundición Maxxima" data-i18n-alt-es="Logotipo de Fundición Maxxima" data-i18n-alt-en="Fundición Maxxima logo" class="maxxima-side-logo reveal" style="--d:2" loading="lazy" />
      )}
    </div>

    {!condensed && (
      <div class="maxxima-photos reveal" style="--d:1">
        <img src="/assets/img/maxxima/hornos.jpg" alt="Horno de fundición de Fundición Maxxima" data-i18n-alt-es="Horno de fundición de Fundición Maxxima" data-i18n-alt-en="Fundición Maxxima smelting furnace">
        <img src="/assets/img/metal-texture.jpg" alt="Colada de metal fundido" data-i18n-alt-es="Colada de metal fundido" data-i18n-alt-en="Molten metal casting">
        <img src="/assets/img/maxxima/planta-1.jpg" alt="Planta de Fundición Maxxima" data-i18n-alt-es="Planta de Fundición Maxxima" data-i18n-alt-en="Fundición Maxxima plant">
      </div>
    )}

    {!condensed && (
    <div class="stat-row stat-row-dark">
      <div class="stat-card dark reveal" style="--d:1">
        <span class="stat-icon" aria-hidden="true" set:html={STAT_ICONS.clock} />
        <span class="stat-number" data-count="15" data-suffix="+">0</span>
        <span class="stat-label" data-i18n="maxxima.stat1">Años de experiencia</span>
      </div>
      <div class="stat-card dark reveal" style="--d:2">
        <span class="stat-icon" aria-hidden="true" set:html={STAT_ICONS.flame} />
        <span class="stat-number" data-count="1200" data-suffix="+">0</span>
        <span class="stat-label" data-i18n="maxxima.stat2">Ton/mes · hornos reverberos</span>
      </div>
      <div class="stat-card dark reveal" style="--d:3">
        <span class="stat-icon" aria-hidden="true" set:html={STAT_ICONS.rotate} />
        <span class="stat-number" data-count="1000" data-suffix="+">0</span>
        <span class="stat-label" data-i18n="maxxima.stat3">Ton/mes · hornos rotatorios</span>
      </div>
    </div>
    )}

    {!condensed && (
      <>
        <div class="maxxima-grid">
          <div class="maxxima-card reveal" style="--d:1; background-image: url('/assets/img/maxxima/planta-2.jpg')">
            <h3 data-i18n="maxxima.card1.title">Laboratorio</h3>
            <p data-i18n="maxxima.card1.body">Control químico mediante analizador Spectro continuamente calibrado, con certificado de análisis por lote.</p>
          </div>
          <div class="maxxima-card reveal" style="--d:2; background-image: url('/assets/img/maxxima/planta-1.jpg')">
            <h3 data-i18n="maxxima.card2.title">Planta piloto</h3>
            <p data-i18n="maxxima.card2.body">Pruebas de materiales, subproductos, minerales y aleaciones.</p>
          </div>
          <div class="maxxima-card reveal" style="--d:3; background-image: url('/assets/img/maxxima/hornos.jpg')">
            <h3 data-i18n="maxxima.card3.title">Aleaciones bajo especificación</h3>
            <p data-i18n="maxxima.card3.body">Cada aleación se fabrica conforme a la especificación y presentación que el cliente requiera.</p>
          </div>
          <div class="maxxima-card reveal" style="--d:1; background-image: url('/assets/img/metal-texture.jpg')">
            <h3 data-i18n="maxxima.card4.title">Responsabilidad ambiental</h3>
            <p data-i18n="maxxima.card4.body">Procesamos los subproductos de la industria metalúrgica en nuevos recursos, reduciendo el impacto ambiental.</p>
          </div>
        </div>

        <div class="maxxima-actions">
          <a href="/contacto" class="btn-cta reveal" style="--d:2" data-i18n="maxxima.cta1">Cotizar con Fundición Maxxima</a>
        </div>
      </>
    )}
  </div>
</section>
