---
const EMBERS = Array.from({ length: 14 }, (_, i) => ({
  left: (5 + (i * 7.1) % 92).toFixed(1),
  dx: (((i * 37) % 60) - 30).toFixed(0),
  duration: (7 + (i % 5) * 1.6).toFixed(1),
  delay: (-(i * 1.3) % 10).toFixed(1),
}));
---
<section class="hero" id="inicio">
  <video class="hero-video" autoplay muted loop playsinline poster="/assets/img/hero-poster.jpg">
    <source src="/assets/video/hero-foundry.mp4" type="video/mp4">
  </video>
  <div class="hero-overlay" aria-hidden="true"></div>
  <div class="hero-embers" aria-hidden="true">
    {EMBERS.map((e) => (
      <span class="ember" style={`--ex:${e.left}%; --edx:${e.dx}px; --edur:${e.duration}s; --edelay:${e.delay}s`}></span>
    ))}
  </div>

  <div class="container hero-grid">
    <div class="hero-copy">
      <h1 class="reveal in-view" data-i18n-es="Proveedor líder de metales no ferrosos y piezas especializadas para la industria metalúrgica" data-i18n-en="Leading supplier of non-ferrous metals and specialized parts for the metallurgical industry">Proveedor líder de metales no ferrosos y piezas especializadas para la industria metalúrgica</h1>
      <div class="hero-actions">
        <a href="/contacto" class="btn-cta" data-i18n="hero.cta1">Solicita tu cotización</a>
        <a href="/productos" class="btn-ghost light" data-i18n="hero.cta2">Ver catálogo de productos</a>
      </div>
    </div>
  </div>
</section>

<section class="hero-stats" aria-label="CONEXT en cifras" data-i18n-aria-label-es="CONEXT en cifras" data-i18n-aria-label-en="CONEXT in figures">
  <div class="container hero-stats-grid">
    <div class="hero-stat reveal" style="--d:1">
      <span class="hero-stat-num" data-count="28">28</span>
      <span class="hero-stat-text">
        <em>+</em>
        <span data-i18n="nosotros.stat1">Años de experiencia</span>
      </span>
    </div>
    <div class="hero-stat reveal" style="--d:2">
      <span class="hero-stat-num" data-count="3">3</span>
      <span class="hero-stat-text">
        <em data-i18n="hero.countries">México · EUA · China</em>
        <span data-i18n="nosotros.stat3">Países con presencia</span>
      </span>
    </div>
    <div class="hero-stat reveal" style="--d:3">
      <span class="hero-stat-num"><sup>ISO</sup>9001</span>
      <span class="hero-stat-text">
        <em>2015</em>
        <span data-i18n="hero.chip2">Calidad certificada en cada lote</span>
      </span>
    </div>
    <div class="hero-stat reveal" style="--d:4">
      <span class="hero-stat-num" data-count="1998">1998</span>
      <span class="hero-stat-text">
        <em>Monterrey, N.L.</em>
        <span data-i18n="nosotros.stat2">Año de fundación</span>
      </span>
    </div>
  </div>
</section>
