---
import Presencia from './Presencia.astro';

const MV_ICONS = {
  target: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1"/></svg>',
  eye: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 12S6 5 12 5s9.5 7 9.5 7-3.5 7-9.5 7-9.5-7-9.5-7Z"/><circle cx="12" cy="12" r="3"/></svg>',
};
---
<section class="historia tech-grid scroll-grid" id="nosotros">
  <div class="container">
    <span class="eyebrow reveal" data-i18n="nosotros.page.trayectoriaEyebrow">Trayectoria</span>
    <p class="section-lead reveal" style="--d:1" data-i18n="nosotros.page.trayectoriaBody">Hoy trabajamos principalmente con clientes de volumen importante, desarrollando aleaciones a la medida de cada operación. Nuestra línea de Metales mantiene un enfoque corporativo y de respaldo a la industria, mientras que nuestra línea de Productos Químicos está en expansión, llevando la misma calidad y seriedad a nuevas industrias y aplicaciones.</p>
  </div>
</section>

<section class="mv-editorial-section tech-grid-dark">
  <div class="container mv-editorial">
    <div class="mv-editorial-item reveal" style="--d:1">
      <span class="mv-editorial-icon" aria-hidden="true" set:html={MV_ICONS.target} />
      <h3 data-i18n="nosotros.mision.title">Misión</h3>
      <p data-i18n="nosotros.mision.body">En CONEXT estamos comprometidos con la calidad, entregando a nuestros clientes productos a un precio competitivo y asesoría técnica de acuerdo a sus necesidades.</p>
    </div>
    <span class="mv-editorial-divider" aria-hidden="true"></span>
    <div class="mv-editorial-item reveal" style="--d:2">
      <span class="mv-editorial-icon" aria-hidden="true" set:html={MV_ICONS.eye} />
      <h3 data-i18n="nosotros.vision.title">Visión</h3>
      <p data-i18n="nosotros.vision.body">Mantenernos como líderes y desarrollar nuevos mercados, así como nuevos productos en el ramo, que nuestros actuales y futuros clientes requieran, a fin de satisfacer sus necesidades en cuanto a calidad, costo y servicio.</p>
    </div>
  </div>
</section>

<Presencia reverse tightTop />
