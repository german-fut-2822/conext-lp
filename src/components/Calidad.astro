---
// Iconos según la nota del Sites: escudo, clipboard con check y engranaje.
const puntos = [
  {
    texto: 'La mejora continua de nuestros procesos.',
    en: 'Continuous improvement of our processes.',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/></svg>',
  },
  {
    texto: 'El desarrollo de nuestro personal.',
    en: 'The development of our people.',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="8" y="2" width="8" height="4" rx="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="m9 14 2 2 4-4"/></svg>',
  },
  {
    texto: 'La integración de nuestros proveedores.',
    en: 'The integration of our suppliers.',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1Z"/></svg>',
  },
];
---
<section class="quality tech-grid" id="calidad">
  <div class="container quality-grid">
    <div class="reveal">
      <h2 data-i18n="calidad.title">Nuestra política de calidad</h2>
      <p data-i18n="calidad.body">En CONEXT estamos comprometidos con la calidad de los metales, químicos industriales y de minería que entregamos a nuestros clientes, a través de:</p>
      <ul class="quality-list">
        {puntos.map((p) => (
          <li>
            <span class="quality-icon" set:html={p.icon} />
            <span data-i18n-es={p.texto} data-i18n-en={p.en}>{p.texto}</span>
          </li>
        ))}
      </ul>
    </div>
    <div class="cert-card reveal" style="--d:1">
      <span class="cert-ribbon" data-i18n-es="Certificación" data-i18n-en="Certification">Certificación</span>
      <img src="/assets/img/conext-logo.png" alt="CONEXT" class="iso-logo-mark" loading="lazy">
      <span class="iso-logo-text">ISO 9001 : 2015</span>
    </div>
  </div>
</section>
