type Spec = { label: string; labelEn: string; val: string; valEn: string };
type FichaSimple = {
  tipo: 'simple';
  simbolos: string[];
  nombre: string; nombreEn: string;
  especificacion: string; especificacionEn: string;
  descripcion?: string; descripcionEn?: string;
  presentacion: string; presentacionEn: string;
  caracteristicas?: Spec[];
  empaque: string; empaqueEn: string;
  calidad: string; calidadEn: string;
};
type SerieAleacion = {
  grado: string;
  comp: { el: string; val: string; valEn?: string }[];
  uso: string; usoEn: string;
};
type FichaAleacion = {
  tipo: 'aleacion';
  simbolos: string[];
  nombre: string; nombreEn: string;
  presentacion: string; presentacionEn: string;
  series: SerieAleacion[];
  caracteristicas: Spec[];
  empaque: string; empaqueEn: string;
  calidad: string; calidadEn: string;
};
type FichaCertificado = {
  tipo: 'certificado';
  simbolos: string[];
  nombre: string; nombreEn: string;
  columnas: { es: string; en: string }[];
  filas: { es: string; en: string; valores: string[]; valoresEn?: string[] }[];
};
type Ficha = FichaSimple | FichaAleacion | FichaCertificado;

