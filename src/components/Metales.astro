      { grado: 'Al-413', comp: [{el:'Si',val:'11.0-13.0'},{el:'Fe',val:'2.0 máx.',valEn:'2.0 max.'},{el:'Cu',val:'1.0'},{el:'Mn',val:'0.35'},{el:'Mg',val:'0.10'},{el:'Cr',val:'—'},{el:'Ni',val:'0.50'},{el:'Zn',val:'0.50'},{el:'Sn',val:'0.15'},{el:'Ti',val:'—'}], uso: 'Se utiliza en la inyección a presión.', usoEn: 'Used in pressure die-casting.' },
      { grado: 'Al-6063', comp: [{el:'Si',val:'0.4062'},{el:'Fe',val:'0.2065'},{el:'Cu',val:'<0.0010'},{el:'Mn',val:'<0.0100'},{el:'Mg',val:'0.4620'},{el:'Cr',val:'<0.0010'},{el:'Ni',val:'0.0055'},{el:'Zn',val:'<0.0100'},{el:'Sn',val:'<0.0010'},{el:'Ti',val:'0.0081'}], uso: 'Se utiliza en la inyección a presión.', usoEn: 'Used in pressure die-casting.' },
    ],
    caracteristicas: [
      { label: 'Densidad', labelEn: 'Density', val: '2.70 g/ml', valEn: '2.70 g/ml' },
      { label: 'Punto de Fusión', labelEn: 'Fusion Point', val: '660°C', valEn: '660°C' },
      { label: 'Punto de Ebullición', labelEn: 'Boiling Point', val: '2450°C', valEn: '2450°C' },
      { label: 'Peso Atómico', labelEn: 'Atomic Weight', val: '26.9815', valEn: '26.9815' },
      { label: 'Dureza Brinell', labelEn: 'Brinell Hardness', val: '24 HB', valEn: '24 HB' },
    ],
    empaque: 'Lingote de 12 kg: en atados de 1 ton. Granalla en costales de 30 kg en supersacos de 1 ton.',
    empaqueEn: 'Ingot of 12 kg: tied sets of 1 ton. Shot in 30 kg bags within 1 ton super sacks.',
    calidad: 'Entrega de certificado en cada lote.', calidadEn: 'Certificate delivered with every lot.',
  },
};

// Solo estos productos tienen ficha técnica en PDF disponible (COA proporcionado
// por el cliente, 2026-11-24). El resto de las fichas no muestra enlace de
// descarga hasta que haya un PDF real que enlazar — no inventar el archivo.
const FICHAS_CON_PDF = new Set(['estano-grado-a', 'estano-4n', 'antimonio-lingote', 'antimonio-polvo', 'soleras-cobre', 'hojas-aluminio']);
---
<section class="products tech-grid" id="metales">
  {home ? (
    <div class="container">
    <h2 class="reveal" data-i18n-es="Productos metálicos" data-i18n-en="Metal products">Productos metálicos</h2>
    <p class="section-lead reveal" style="--d:1" data-i18n="metales.lead">Comercialización de metales no ferrosos y piezas especializadas para la industria metalúrgica, con el respaldo y la consistencia que exigen las operaciones de gran volumen.</p>
    <div class="metal-grid">
      {categorias.map((cat, i) => (
        <details class="metal-tile reveal" style={`--d:${(i % 3) + 1}`}>
          <summary class="metal-tile-summary">
            <div class:list={['home-metal-elements', `count-${cat.simbolos.length}`]} aria-hidden="true">
              {cat.simbolos.map((s) => (
                <span class="home-element-panel">
                  <span class="home-element-number">{ELEMENTOS[s].num}</span>
                  <span class="home-element-symbol">{s}</span>
                  <span
                    class="home-element-name"
                    data-i18n-es={ELEMENTOS[s].nombre}
                    data-i18n-en={ELEMENTOS[s].en}
                  >{ELEMENTOS[s].nombre}</span>
                </span>
              ))}
            </div>
            <div class="metal-tile-info">
              <span class="metal-tile-name" data-i18n-es={cat.nombre} data-i18n-en={cat.en}>{cat.nombre}</span>
              <span class="metal-tile-foot">
                {(() => {
                  const n = cat.bullets.length;
                  const es = `${n} ${n === 1 ? 'producto' : 'productos'}`;
                  const en = `${n} ${n === 1 ? 'product' : 'products'}`;
                  return <span data-i18n-es={es} data-i18n-en={en}>{es}</span>;
                })()}
                <span class="metal-tile-caret" aria-hidden="true">▾</span>
              </span>
            </div>
          </summary>
          <ul class="metal-tile-products">
            {cat.bullets.map((b) => (
              <li data-i18n-es={b.es} data-i18n-en={b.en}>{b.es}</li>
            ))}
          </ul>
          <a href={`/productos/metales#${cat.id}`} class="metal-tile-more">
            <span data-i18n-es="Ver más" data-i18n-en="View more">Ver más</span>
            <span aria-hidden="true">→</span>
          </a>
        </details>
      ))}
    </div>
    </div>
  ) : (
  <div class="container">
    <div class="metal-grid">
      {categorias.map((cat, i) => (
        <details class="metal-tile reveal" id={cat.id} style={`--d:${(i % 3) + 1}`}>
          <summary class="metal-tile-summary">
            <div class:list={['home-metal-elements', `count-${cat.simbolos.length}`]} aria-hidden="true">
              {cat.simbolos.map((s) => (
                <span class="home-element-panel">
                  <span class="home-element-number">{ELEMENTOS[s].num}</span>
                  <span class="home-element-symbol">{s}</span>
                  <span
                    class="home-element-name"
                    data-i18n-es={ELEMENTOS[s].nombre}
                    data-i18n-en={ELEMENTOS[s].en}
                  >{ELEMENTOS[s].nombre}</span>
                </span>
              ))}
            </div>
            <div class="metal-tile-info">
              <span class="metal-tile-name" data-i18n-es={cat.nombre} data-i18n-en={cat.en}>{cat.nombre}</span>
              <span class="metal-tile-foot">
                {(() => {
                  const n = cat.bullets.length;
                  const es = `${n} ${n === 1 ? 'producto' : 'productos'}`;
                  const en = `${n} ${n === 1 ? 'product' : 'products'}`;
                  return <span data-i18n-es={es} data-i18n-en={en}>{es}</span>;
                })()}
                <span class="metal-tile-caret" aria-hidden="true">▾</span>
              </span>
            </div>
          </summary>
          <ul class="metal-tile-products">
            {cat.bullets.map((b) => (
              b.fichaId ? (
                <li><button type="button" class="ficha-trigger" data-ficha={b.fichaId} data-i18n-es={b.es} data-i18n-en={b.en}>{b.es}</button></li>
              ) : (
                <li><span data-i18n-es={b.es} data-i18n-en={b.en}>{b.es}</span></li>
              )
            ))}
          </ul>
        </details>
      ))}
    </div>
  </div>
  )}
</section>

<div class="ficha-modal" id="fichaModal" aria-hidden="true">
  <div class="ficha-modal-backdrop" data-ficha-close></div>
  <div class="ficha-modal-panel" role="dialog" aria-modal="true" aria-labelledby="fichaModalTitle">
    <button type="button" class="ficha-modal-close" data-ficha-close aria-label="Cerrar" data-i18n-aria-label-es="Cerrar" data-i18n-aria-label-en="Close">&times;</button>
    <div class="ficha-modal-body" id="fichaModalBody"></div>
  </div>
</div>

{Object.entries(fichas).map(([id, f]) => (
  <template id={`ficha-${id}`}>
    <h3 id="fichaModalTitle" data-i18n-es={f.nombre} data-i18n-en={f.nombreEn}>{f.nombre}</h3>
    <div class:list={['ficha-elems', { multi: f.simbolos.length > 1 }]} aria-hidden="true">
      {f.simbolos.map((s) => (
        <span class="elem-badge lg">
          <span class="elem-badge-num">{ELEMENTOS[s].num}</span>
          <span class="elem-badge-symbol">{s}</span>
        </span>
      ))}
    </div>
    {f.tipo === 'certificado' ? (
      <>
        <div class="ficha-table-wrap">
          <table class="ficha-cert-table">
            <thead><tr>{f.columnas.map((c) => <th data-i18n-es={c.es} data-i18n-en={c.en}>{c.es}</th>)}</tr></thead>
            <tbody>{f.filas.map((fila) => (
              <tr>
                <th data-i18n-es={fila.es} data-i18n-en={fila.en}>{fila.es}</th>
                {fila.valores.map((valor, i) => <td data-i18n-es={valor} data-i18n-en={fila.valoresEn?.[i] ?? valor}>{valor}</td>)}
              </tr>
            ))}</tbody>
          </table>
        </div>
        {FICHAS_CON_PDF.has(id) && (
          <a
            class="ficha-pdf-link"
            href={`/assets/docs/fichas/${id}-es.pdf`}
            data-i18n-href-es={`/assets/docs/fichas/${id}-es.pdf`}
            data-i18n-href-en={`/assets/docs/fichas/${id}-en.pdf`}
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m0 0 4-4m-4 4-4-4"/><path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/></svg>
            <span data-i18n-es="Descargar ficha técnica (PDF)" data-i18n-en="Download technical datasheet (PDF)">Descargar ficha técnica (PDF)</span>
          </a>
        )}
      </>
    ) : f.tipo === 'simple' ? (
      <>
        <dl class="ficha-specs">
          <div><dt data-i18n-es="Especificación" data-i18n-en="Specification">Especificación</dt><dd data-i18n-es={f.especificacion} data-i18n-en={f.especificacionEn}>{f.especificacion}</dd></div>
          <div><dt data-i18n-es="Presentación" data-i18n-en="Presentation">Presentación</dt><dd data-i18n-es={f.presentacion} data-i18n-en={f.presentacionEn}>{f.presentacion}</dd></div>
          <div><dt data-i18n-es="Empaque" data-i18n-en="Packing">Empaque</dt><dd data-i18n-es={f.empaque} data-i18n-en={f.empaqueEn}>{f.empaque}</dd></div>
          <div><dt data-i18n-es="Calidad" data-i18n-en="Quality">Calidad</dt><dd data-i18n-es={f.calidad} data-i18n-en={f.calidadEn}>{f.calidad}</dd></div>
        </dl>
        {f.descripcion && <p class="ficha-desc" data-i18n-es={f.descripcion} data-i18n-en={f.descripcionEn}>{f.descripcion}</p>}
        {f.caracteristicas && (
          <>
            <h4 data-i18n-es="Características Físicas y Mecánicas" data-i18n-en="Physical and Mechanical Characteristics">Características Físicas y Mecánicas</h4>
            <ul class="ficha-caracteristicas">
              {f.caracteristicas.map((c) => (
                <li><span data-i18n-es={c.label} data-i18n-en={c.labelEn}>{c.label}</span>: <strong data-i18n-es={c.val} data-i18n-en={c.valEn}>{c.val}</strong></li>
              ))}
            </ul>
          </>
        )}
      </>
    ) : (
      <>
        <dl class="ficha-specs">
          <div><dt data-i18n-es="Presentación" data-i18n-en="Presentation">Presentación</dt><dd data-i18n-es={f.presentacion} data-i18n-en={f.presentacionEn}>{f.presentacion}</dd></div>
          <div><dt data-i18n-es="Empaque" data-i18n-en="Packing">Empaque</dt><dd data-i18n-es={f.empaque} data-i18n-en={f.empaqueEn}>{f.empaque}</dd></div>
          <div><dt data-i18n-es="Calidad" data-i18n-en="Quality">Calidad</dt><dd data-i18n-es={f.calidad} data-i18n-en={f.calidadEn}>{f.calidad}</dd></div>
        </dl>
        <h4 data-i18n-es="Características Físicas y Mecánicas" data-i18n-en="Physical and Mechanical Characteristics">Características Físicas y Mecánicas</h4>
        <ul class="ficha-caracteristicas">
          {f.caracteristicas.map((c) => (
            <li><span data-i18n-es={c.label} data-i18n-en={c.labelEn}>{c.label}</span>: <strong data-i18n-es={c.val} data-i18n-en={c.valEn}>{c.val}</strong></li>
          ))}
        </ul>
        <h4 data-i18n-es="Series de aleación" data-i18n-en="Alloy series">Series de aleación</h4>
        <div class="ficha-series-grid">
          {f.series.map((s) => (
            <div class="ficha-serie">
              <strong>{s.grado}</strong>
              <table class="ficha-comp-table">
                <thead><tr>{s.comp.map((c) => <th>{c.el}</th>)}</tr></thead>
                <tbody><tr>{s.comp.map((c) => <td data-i18n-es={c.val} data-i18n-en={c.valEn ?? c.val}>{c.val}</td>)}</tr></tbody>
              </table>
              <p data-i18n-es={s.uso} data-i18n-en={s.usoEn}>{s.uso}</p>
            </div>
          ))}
        </div>
      </>
    )}
  </template>
))}
