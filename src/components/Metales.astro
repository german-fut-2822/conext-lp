---
// Contenido verbatim del Google Sites (Inicio y Productos/Metales). A petición
// del cliente (2026-11-27) ya no se muestran fichas técnicas en el sitio: al dar
// clic en el nombre de un producto se abre un aviso para contactarnos. Ver
// memoria del proyecto "project-sites-governs-content-and-order".
export interface Props {
  showEyebrow?: boolean;
  home?: boolean;
}
const { showEyebrow = true, home = false } = Astro.props;

type Bullet = { es: string; en: string };
type Categoria = { id: string; nombre: string; en: string; bullets: Bullet[]; simbolos: string[] };

// Símbolos y números atómicos reales (IUPAC) — se usan como identidad visual de cada
// categoría/ficha en vez de fotografía, a petición del cliente (2026-10-15): "usar la
// fórmula o letras del elemento al que se hace referencia... no poner una imagen".
const ELEMENTOS: Record<string, { num: number; nombre: string; en: string }> = {
  Sn: { num: 50, nombre: 'Estaño', en: 'Tin' },
  Sb: { num: 51, nombre: 'Antimonio', en: 'Antimony' },
  Cu: { num: 29, nombre: 'Cobre', en: 'Copper' },
  Al: { num: 13, nombre: 'Aluminio', en: 'Aluminum' },
  Zn: { num: 30, nombre: 'Zinc', en: 'Zinc' },
  Pb: { num: 82, nombre: 'Plomo', en: 'Lead' },
  Au: { num: 79, nombre: 'Oro', en: 'Gold' },
  Ag: { num: 47, nombre: 'Plata', en: 'Silver' },
  Se: { num: 34, nombre: 'Selenio', en: 'Selenium' },
  Ga: { num: 31, nombre: 'Galio', en: 'Gallium' },
  Te: { num: 52, nombre: 'Telurio', en: 'Tellurium' },
  In: { num: 49, nombre: 'Indio', en: 'Indium' },
};

const categorias: Categoria[] = [
  {
    id: 'estano', nombre: 'Estaño', en: 'Tin', simbolos: ['Sn'],
    bullets: [
      { es: 'Estaño Grado A en lingote.', en: 'Grade A tin in ingot form.' },
      { es: 'Estaño de alta pureza (4N) en lingote.', en: 'High-purity (4N) tin in ingot form.' },
      { es: 'Alambre de soldadura sin plomo con núcleo de fundente.', en: 'Lead-free flux-core solder wire.' },
      { es: 'Alambre de soldadura sin plomo sólido.', en: 'Lead-free solid solder wire.' },
      { es: 'Alambre de soldadura con plomo con núcleo de fundente.', en: 'Leaded flux-core solder wire.' },
      { es: 'Alambre de soldadura con plomo sólido.', en: 'Leaded solid solder wire.' },
    ],
  },
  {
    id: 'antimonio', nombre: 'Antimonio', en: 'Antimony', simbolos: ['Sb'],
    bullets: [
      { es: 'Antimonio en lingote.', en: 'Antimony in ingot form.' },
      { es: 'Antimonio en granalla.', en: 'Antimony shot.' },
      { es: 'Antimonio en polvo.', en: 'Antimony powder.' },
    ],
  },
  {
    id: 'cobre', nombre: 'Cobre', en: 'Copper', simbolos: ['Cu'],
    bullets: [
      { es: 'Soleras de cobre / BUSBAR.', en: 'Copper busbar.' },
      { es: 'Contactos bimetálicos.', en: 'Bimetallic contacts.' },
      { es: 'Placas bimetálicas.', en: 'Bimetallic plates.' },
    ],
  },
  {
    id: 'aluminio', nombre: 'Aluminio', en: 'Aluminum', simbolos: ['Al'],
    bullets: [
      { es: 'Granalla de aluminio.', en: 'Aluminum shot.' },
      { es: 'Aluminio P1020.', en: 'P1020 aluminum.' },
      { es: 'Hojas de aluminio 1070/H19.', en: 'Aluminum plate 1070/H19.' },
    ],
  },
  {
    id: 'zinc', nombre: 'Zinc', en: 'Zinc', simbolos: ['Zn'],
    bullets: [
      { es: 'Zinc SHG (Grado alto especial).', en: 'Zinc SHG (Special High Grade).' },
      { es: 'Zinc HG (Grado alto).', en: 'Zinc HG (High Grade).' },
    ],
  },
  {
    id: 'plomo', nombre: 'Plomo', en: 'Lead', simbolos: ['Pb'],
    bullets: [
      { es: 'Plomo afinado', en: 'Refined lead' },
    ],
  },
  {
    id: 'oro', nombre: 'Oro', en: 'Gold', simbolos: ['Au'],
    bullets: [
      { es: 'Oro.', en: 'Gold.' },
    ],
  },
  {
    id: 'plata', nombre: 'Plata', en: 'Silver', simbolos: ['Ag'],
    bullets: [
      { es: 'Plata', en: 'Silver' },
    ],
  },
  {
    id: 'tierras-raras', nombre: 'Tierras Raras', en: 'Rare Earths', simbolos: ['Se', 'Ga', 'Te', 'In'],
    bullets: [
      { es: 'Selenio.', en: 'Selenium.' },
      { es: 'Galio.', en: 'Gallium.' },
      { es: 'Telurio.', en: 'Tellurium.' },
      { es: 'Indio.', en: 'Indium.' },
    ],
  },
];

---
<section class="products tech-grid" id="metales">
  {home ? (
    <div class="container">
    <h2 class="reveal" data-i18n-es="Productos metálicos" data-i18n-en="Metal products">Productos metálicos</h2>
    <p class="section-lead reveal" style="--d:1" data-i18n="metales.lead">Comercialización de metales no ferrosos y piezas especializadas para la industria metalúrgica, con el respaldo y la consistencia que exigen las operaciones de gran volumen.</p>
    <div class="metal-grid">
      {categorias.map((cat, i) => (
        <details class="metal-tile reveal" style={`--d:${(i % 3) + 1}`}>
          <summary class="metal-tile-summary">
            <div class:list={['home-metal-elements', `count-${cat.simbolos.length}`]} aria-hidden="true">
              {cat.simbolos.map((s) => (
                <span class="home-element-panel">
                  <span class="home-element-number">{ELEMENTOS[s].num}</span>
                  <span class="home-element-symbol">{s}</span>
                  <span
                    class="home-element-name"
                    data-i18n-es={ELEMENTOS[s].nombre}
                    data-i18n-en={ELEMENTOS[s].en}
                  >{ELEMENTOS[s].nombre}</span>
                </span>
              ))}
            </div>
            <div class="metal-tile-info">
              <span class="metal-tile-name" data-i18n-es={cat.nombre} data-i18n-en={cat.en}>{cat.nombre}</span>
              <span class="metal-tile-foot">
                {(() => {
                  const n = cat.bullets.length;
                  const es = `${n} ${n === 1 ? 'producto' : 'productos'}`;
                  const en = `${n} ${n === 1 ? 'product' : 'products'}`;
                  return <span data-i18n-es={es} data-i18n-en={en}>{es}</span>;
                })()}
                <span class="metal-tile-caret" aria-hidden="true">▾</span>
              </span>
            </div>
          </summary>
          <ul class="metal-tile-products">
            {cat.bullets.map((b) => (
              <li><button type="button" class="ficha-trigger" data-categoria="metales" data-i18n-es={b.es} data-i18n-en={b.en}>{b.es}</button></li>
            ))}
          </ul>
        </details>
      ))}
    </div>
    </div>
  ) : (
  <div class="container">
    <div class="metal-grid">
      {categorias.map((cat, i) => (
        <details class="metal-tile reveal" id={cat.id} style={`--d:${(i % 3) + 1}`}>
          <summary class="metal-tile-summary">
            <div class:list={['home-metal-elements', `count-${cat.simbolos.length}`]} aria-hidden="true">
              {cat.simbolos.map((s) => (
                <span class="home-element-panel">
                  <span class="home-element-number">{ELEMENTOS[s].num}</span>
                  <span class="home-element-symbol">{s}</span>
                  <span
                    class="home-element-name"
                    data-i18n-es={ELEMENTOS[s].nombre}
                    data-i18n-en={ELEMENTOS[s].en}
                  >{ELEMENTOS[s].nombre}</span>
                </span>
              ))}
            </div>
            <div class="metal-tile-info">
              <span class="metal-tile-name" data-i18n-es={cat.nombre} data-i18n-en={cat.en}>{cat.nombre}</span>
              <span class="metal-tile-foot">
                {(() => {
                  const n = cat.bullets.length;
                  const es = `${n} ${n === 1 ? 'producto' : 'productos'}`;
                  const en = `${n} ${n === 1 ? 'product' : 'products'}`;
                  return <span data-i18n-es={es} data-i18n-en={en}>{es}</span>;
                })()}
                <span class="metal-tile-caret" aria-hidden="true">▾</span>
              </span>
            </div>
          </summary>
          <ul class="metal-tile-products">
            {cat.bullets.map((b) => (
              <li><button type="button" class="ficha-trigger" data-categoria="metales" data-i18n-es={b.es} data-i18n-en={b.en}>{b.es}</button></li>
            ))}
          </ul>
        </details>
      ))}
    </div>
  </div>
  )}
</section>

<div class="ficha-modal" id="fichaModal" aria-hidden="true">
  <div class="ficha-modal-backdrop" data-ficha-close></div>
  <div class="ficha-modal-panel" role="dialog" aria-modal="true" aria-labelledby="fichaModalTitle">
    <button type="button" class="ficha-modal-close" data-ficha-close aria-label="Cerrar" data-i18n-aria-label-es="Cerrar" data-i18n-aria-label-en="Close">&times;</button>
    <div class="ficha-modal-body" id="fichaModalBody"></div>
  </div>
</div>
