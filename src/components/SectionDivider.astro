---
export interface Props {
  label: string;
  labelKey?: string;
}
const { label, labelKey } = Astro.props;
---
<div class="section-divider">
  <div class="container section-divider-inner">
    <span class="section-divider-line" aria-hidden="true"></span>
    <span class="section-divider-label" data-i18n={labelKey}>{label}</span>
    <span class="section-divider-line" aria-hidden="true"></span>
  </div>
</div>
