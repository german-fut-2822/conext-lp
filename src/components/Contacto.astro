<section class="contact form-bg" id="contacto">
  <div class="container contact-grid form-bg-content">
    <div class="contact-info reveal">
      <h2 data-i18n="contacto.title">La solución que buscas, a un mensaje de distancia</h2>
      <p data-i18n="contacto.lead">Cuéntanos qué material o producto necesitas y un especialista de CONEXT te contactará a la brevedad.</p>
      <ul class="contact-details">
        <li><strong data-i18n="contacto.tel">Teléfono:</strong> <a href="tel:+528183334097">(+81) 8333-4097</a></li>
        <li><strong data-i18n="contacto.correo">Correo:</strong> <a href="mailto:ventas@conext.com.mx">ventas@conext.com.mx</a></li>
        <li><strong data-i18n="contacto.direccion">Dirección:</strong> Tenango No. 333, Col. Mitras, 64460 Monterrey, N.L. México</li>
      </ul>
    </div>

    <form class="contact-form reveal" style="--d:1" id="contactForm" data-origen="Inicio" novalidate>
      <div class="form-row">
        <div class="form-field">
          <label for="nombre" data-i18n="contacto.form.nombre">Nombre y apellido</label>
          <input type="text" id="nombre" name="nombre" required>
        </div>
        <div class="form-field">
          <label for="empresa" data-i18n="contacto.form.empresa">Empresa</label>
          <input type="text" id="empresa" name="empresa" required>
        </div>
      </div>
      <div class="form-row">
        <div class="form-field">
          <label for="correo" data-i18n="contacto.form.correo">Correo corporativo</label>
          <input type="email" id="correo" name="correo" required>
        </div>
        <div class="form-field">
          <label for="telefono" data-i18n="contacto.form.telefono">Teléfono</label>
          <input type="tel" id="telefono" name="telefono" required>
        </div>
      </div>
      <div class="form-field">
        <label for="producto" data-i18n="contacto.form.producto">Producto o material de interés</label>
        <select id="producto" name="producto">
          <option value="" data-i18n="contacto.form.opt0">Selecciona una opción</option>
          <option data-i18n="contacto.form.opt1">Metales no ferrosos</option>
          <option data-i18n="contacto.form.opt2">Químicos industriales</option>
          <option data-i18n="contacto.form.opt3">Fundición Maxxima</option>
          <option data-i18n="contacto.form.opt4">Otro</option>
        </select>
      </div>
      <div class="form-field">
        <label for="mensaje" data-i18n="contacto.form.mensaje">Mensaje</label>
        <textarea id="mensaje" name="mensaje" rows="4" required></textarea>
      </div>
      <input type="text" name="empresa_web" class="hp-field" tabindex="-1" autocomplete="off" aria-hidden="true">
      <div class="captcha-placeholder" data-i18n="contacto.form.captcha">
        reCAPTCHA pendiente de activar — falta dar de alta el dominio y la site key en <a href="https://www.google.com/recaptcha/admin" target="_blank" rel="noopener">google.com/recaptcha/admin</a>.
      </div>
      <button type="submit" class="btn-cta btn-block" data-i18n="contacto.form.enviar">Enviar</button>
      <p class="form-feedback" data-feedback role="status"></p>
      <p class="form-image-note" data-i18n="contacto.form.note">Fondo: textura abstracta de referencia — sustituir por fotografía de metal no ferroso con el mismo tratamiento de blur gris.</p>
    </form>
  </div>
</section>
