---
export interface Props {
  home?: boolean;
}
const { home = false } = Astro.props;
---
<section class="contact" id="contacto">
  <div class="container contact-grid">
    <div class="contact-info reveal">
      {home && <span class="eyebrow" data-i18n="nav.contacto">Contacto</span>}
      {home
        ? <h2 data-i18n-es="Contáctanos ahora" data-i18n-en="Contact us now">Contáctanos ahora</h2>
        : <h2 data-i18n="contacto.title">La solución que buscas, a un mensaje de distancia</h2>}
      <p data-i18n="contacto.lead">Cuéntanos qué material o producto necesitas y un especialista de CONEXT te contactará a la brevedad.</p>
      <ul class="contact-details">
        <li><strong data-i18n="contacto.tel">Teléfono:</strong> <a href="tel:+528183334097">(+52) 818333-4097</a></li>
        <li><strong data-i18n="contacto.correo">Correo:</strong> <a href="mailto:ventas@conext.com.mx">ventas@conext.com.mx</a></li>
        <li><strong data-i18n="contacto.direccion">Dirección:</strong> <span data-i18n-es="Jordan 2723 Col. Mitras Centro, CP 64460 Monterrey, N.L. México." data-i18n-en="Jordan 2723, Col. Mitras Centro, ZIP Code 64460, Monterrey, Nuevo León, Mexico.">Jordan 2723 Col. Mitras Centro, CP 64460 Monterrey, N.L. México.</span></li>
      </ul>
    </div>

    <form class="contact-form reveal" style="--d:1" id="contactForm" data-origen="Inicio" novalidate>
      <div class="form-row">
        <div class="form-field">
          <label for="nombre" class="required-label" data-i18n="contacto.form.nombre">Nombre y apellido</label>
          <input type="text" id="nombre" name="nombre" required>
        </div>
        <div class="form-field">
          <label for="empresa" class="required-label" data-i18n="contacto.form.empresa">Empresa</label>
          <input type="text" id="empresa" name="empresa" required>
        </div>
      </div>
      <div class="form-row">
        <div class="form-field">
          <label for="correo" class="required-label" data-i18n="contacto.form.correo">Correo corporativo</label>
          <input type="email" id="correo" name="correo" required>
        </div>
        <div class="form-field">
          <label for="telefono" class="required-label" data-i18n="contacto.form.telefono">Teléfono</label>
          <input type="tel" id="telefono" name="telefono" required>
        </div>
      </div>
      <div class="form-field">
        <label for="producto" class="required-label" data-i18n="contacto.form.producto">Producto o material de interés</label>
        <select id="producto" name="producto" required>
          <option value="" data-i18n="contacto.form.opt0">Selecciona una opción</option>
          <option data-i18n="contacto.form.opt1">Metales no ferrosos</option>
          <option data-i18n="contacto.form.opt2">Químicos industriales</option>
          <option data-i18n="contacto.form.opt3">Fundición Maxxima</option>
          <option data-i18n="contacto.form.opt4">Otro</option>
        </select>
      </div>
      <div class="form-field">
        <label for="mensaje" class="required-label" data-i18n="contacto.form.mensaje">Mensaje</label>
        <textarea id="mensaje" name="mensaje" rows="4" required></textarea>
      </div>
      <input type="text" name="empresa_web" class="hp-field" tabindex="-1" autocomplete="off" aria-hidden="true">
      <div class="g-recaptcha" data-sitekey="6Lddd-ItAAAAANILbFOD--KXrb7W5i5BE4VHH1aU"></div>
      <p class="recaptcha-note" data-i18n="contacto.form.recaptchaNote">Este sitio está protegido por reCAPTCHA. Aplican la <a href="https://policies.google.com/privacy" target="_blank" rel="noopener">Política de Privacidad</a> y los <a href="https://policies.google.com/terms" target="_blank" rel="noopener">Términos de Servicio</a> de Google.</p>
      <button type="submit" class="btn-cta btn-block" data-i18n="contacto.form.enviar">Enviar</button>
      <p class="form-feedback" data-feedback role="status"></p>
    </form>
  </div>
</section>

<script src="https://www.google.com/recaptcha/api.js" async defer></script>
