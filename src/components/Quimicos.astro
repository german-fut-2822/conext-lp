---
// Contenido verbatim del Google Sites (Inicio y Productos/Químicos). El catálogo
// real de "Productos Químicos" en conext.com.mx (química de fundición: Tartrato
// de Antimonio, Desmoldante, Nitrato de Sodio, Arena de Zirconio) no coincide con
// estos productos aprobados por Selene — confirmado 2026-10-14. Las tarjetas usan
// el mismo diseño que las de Metales (foto + insignia + lista desplegable), con
// fotos en quimicos/*.webp. A petición del cliente (2026-11-27) ya no se muestran
// fichas técnicas: al dar clic en el nombre de un producto se abre un aviso para
// contactarnos. Ver memoria del proyecto "project-sites-governs-content-and-order".
export interface Props {
  showEyebrow?: boolean;
  showIntro?: boolean;
  home?: boolean;
}
const { showEyebrow = true, showIntro = true, home = false } = Astro.props;

type Item = { es: string; en: string };
type Categoria = { id: string; nombre: string; nombreEn: string; icon: string; items: Item[] };

const categorias: Categoria[] = [
  {
    id: 'aditivos', icon: 'capsule',
    nombre: 'Aditivos alimentarios y nutracéuticos', nombreEn: 'Food additives & nutraceuticals',
    items: [
      { es: 'NMN (Mononucleótido de nicotinamida).', en: 'NMN (Nicotinamide Mononucleotide).' },
      { es: 'NR (Ribósido de nicotinamida).', en: 'NR (Nicotinamide Riboside).' },
      { es: 'Taurina.', en: 'Taurine.' },
      { es: 'Monohidrato de creatina.', en: 'Creatine monohydrate.' },
      { es: 'D-glucosamina HCl.', en: 'D-glucosamine HCl.' },
      { es: 'Sulfato de glucosamina.', en: 'Glucosamine sulphate.' },
      { es: 'Condroitina.', en: 'Chondroitin.' },
      { es: 'Vitamina E.', en: 'Vitamin E.' },
      { es: 'D-biotina 2%.', en: 'D-biotin 2%.' },
      { es: 'Ácido fólico.', en: 'Folic acid.' },
      { es: 'Sucralosa.', en: 'Sucralose.' },
      { es: 'Fruta del monje.', en: 'Monk fruit.' },
    ],
  },
  {
    id: 'extractos', icon: 'leaf',
    nombre: 'Extractos naturales', nombreEn: 'Natural extracts',
    items: [
      { es: 'Extracto de té verde / EGCG.', en: 'Green tea extract / EGCG.' },
      { es: 'Extracto de ginseng.', en: 'Ginseng extract.' },
      { es: 'Extracto de hoja de Ginkgo biloba.', en: 'Ginkgo biloba leaf extract.' },
      { es: 'Extracto de stevia TSG95 / Rebaudiósido A 80.', en: 'Stevia extract TSG95 / Rebaudioside A 80.' },
      { es: 'Extracto de hongo Reishi.', en: 'Reishi mushroom extract.' },
    ],
  },
  {
    id: 'cosmeticos', icon: 'droplet',
    nombre: 'Cosméticos y cuidado personal', nombreEn: 'Cosmetics & personal care',
    items: [
      { es: 'Hialuronato de sodio (grado cosmético).', en: 'Sodium hyaluronate (cosmetic grade).' },
      { es: 'Ácido kójico.', en: 'Kojic acid.' },
      { es: 'Alfa-arbutina.', en: 'Alpha-arbutin.' },
      { es: 'Colágeno de pollo.', en: 'Chicken collagen.' },
      { es: 'Ácido etil ascórbico.', en: 'Ethyl ascorbic acid.' },
    ],
  },
];

const icons: Record<string, string> = {
  capsule: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4.93 19.07a5 5 0 0 1 0-7.07l7.07-7.07a5 5 0 1 1 7.07 7.07l-7.07 7.07a5 5 0 0 1-7.07 0Z"/><path d="M9.46 7.46 16.54 14.54"/></svg>',
  leaf: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 4 13c0-4 2.5-8 10-9 1 5-1 8-3 9"/><path d="M4 13c4.5 0 9-2 11-7"/></svg>',
  droplet: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11Z"/></svg>',
};

---
<section class="products alt" id="quimicos">
  <div class="container">
    {showEyebrow && <span class="eyebrow reveal" data-i18n="quimicos.eyebrow">Químicos</span>}
    {showIntro && home && (
      <>
        <h2 class="reveal" data-i18n-es="Productos químicos" data-i18n-en="Chemical products">Productos químicos</h2>
        <p class="section-lead reveal" style="--d:1" data-i18n-es="Soluciones químicas para distintas industrias, con atención personalizada para ayudarte a identificar el producto correcto para tu aplicación." data-i18n-en="Chemical solutions for different industries, with personalized support to help you identify the right product for your application.">Soluciones químicas para distintas industrias, con atención personalizada para ayudarte a identificar el producto correcto para tu aplicación.</p>
      </>
    )}
    {showIntro && !home && (
      <>
        <h2 class="reveal" data-i18n="quimicos.title">Soluciones químicas para distintas industrias</h2>
        <p class="section-lead reveal" style="--d:1" data-i18n="quimicos.lead">Respaldamos a industrias de distintos sectores con soluciones a la medida y volumen consistente.</p>
      </>
    )}

    <div class="metal-grid chem-tiles">
      {categorias.map((cat, i) => (
        <details class="metal-tile reveal" style={`--d:${i + 1}`}>
          <summary class="metal-tile-summary">
            <div class="metal-tile-photo" style={`background-image:url(/assets/img/quimicos/${cat.id}.webp)`}>
              <span class="metal-tile-elems" aria-hidden="true">
                <span class="elem-badge chem-badge" set:html={icons[cat.icon]} />
              </span>
            </div>
            <div class="metal-tile-info">
              <span class="metal-tile-name" data-i18n-es={cat.nombre} data-i18n-en={cat.nombreEn}>{cat.nombre}</span>
              <span class="metal-tile-foot">
                {(() => {
                  const n = cat.items.length;
                  const es = `${n} ${n === 1 ? 'producto' : 'productos'}`;
                  const en = `${n} ${n === 1 ? 'product' : 'products'}`;
                  return <span data-i18n-es={es} data-i18n-en={en}>{es}</span>;
                })()}
                <span class="metal-tile-caret" aria-hidden="true">▾</span>
              </span>
            </div>
          </summary>
          <ul class="metal-tile-products">
            {cat.items.map((it) => (
              <li><button type="button" class="ficha-trigger" data-i18n-es={it.es} data-i18n-en={it.en}>{it.es}</button></li>
            ))}
          </ul>
        </details>
      ))}
    </div>
  </div>
</section>

{!home && (
<div class="ficha-modal" id="fichaModal" aria-hidden="true">
  <div class="ficha-modal-backdrop" data-ficha-close></div>
  <div class="ficha-modal-panel" role="dialog" aria-modal="true" aria-labelledby="fichaModalTitle">
    <button type="button" class="ficha-modal-close" data-ficha-close aria-label="Cerrar" data-i18n-aria-label-es="Cerrar" data-i18n-aria-label-en="Close">&times;</button>
    <div class="ficha-modal-body" id="fichaModalBody"></div>
  </div>
</div>
)}
