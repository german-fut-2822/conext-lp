---
// Presencia y alcance internacional en Inicio y Nosotros.
export interface Props {
  tightTop?: boolean;
  tightBottom?: boolean;
  home?: boolean;
}
const { tightTop = false, tightBottom = false, home = false } = Astro.props;
---
<section class:list={['presencia', { 'tight-top': tightTop, 'tight-bottom': tightBottom }]} id="presencia">
  <div class="container presencia-content">
    <div class="presencia-heading">
      {home ? (
        <h2 class="reveal" data-i18n-es="Presencia y alcance internacional" data-i18n-en="International presence and reach">Presencia y alcance internacional</h2>
      ) : (
        <span class="eyebrow reveal" data-i18n="nosotros.reach.eyebrow">Enfoque y presencia internacional</span>
      )}
    </div>
    {home ? (
      <p class="section-lead reveal" style="--d:1" data-i18n-es="CONEXT conecta mercados y facilita el flujo de materiales: Monterrey como base de operaciones, con puertas estratégicas en Estados Unidos y China." data-i18n-en="CONEXT connects markets and streamlines the flow of materials: Monterrey as our operations base, with strategic gateways in the United States and China.">CONEXT conecta mercados y facilita el flujo de materiales: Monterrey como base de operaciones, con puertas estratégicas en Estados Unidos y China.</p>
    ) : (
      <p class="section-lead reveal" style="--d:1" data-i18n="nosotros.reach.lead">Con presencia en tres países: México, Estados Unidos y China. CONEXT conecta mercados y facilita el flujo de materiales: Monterrey como base de operaciones, Estados Unidos y China como puerta estratégica.</p>
    )}
  </div>
</section>
