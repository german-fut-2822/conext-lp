---
export interface Props {
  showEyebrow?: boolean;
}
const { showEyebrow = true } = Astro.props;
const sectores = [
  {
    nombre: 'Automotriz',
    nombreEn: 'Automotive',
    desc: 'Aleaciones y piezas para componentes y líneas de ensamble.',
    descEn: 'Alloys and parts for components and assembly lines.',
    icon: 'car',
    img: '/assets/img/automotriz.jpg',
  },
  {
    nombre: 'Construcción',
    nombreEn: 'Construction',
    desc: 'Materiales a volumen para infraestructura y proyectos industriales.',
    descEn: 'High-volume materials for infrastructure and industrial projects.',
    icon: 'building',
    img: '/assets/img/construccion.jpg',
  },
  {
    nombre: 'Electrónica y electrodomésticos',
    nombreEn: 'Electronics & appliances',
    desc: 'Metales de alta pureza para manufactura electrónica.',
    descEn: 'High-purity metals for electronics manufacturing.',
    icon: 'chip',
    img: '/assets/img/electronica.jpg',
  },
  {
    nombre: 'Galvanizado y recubrimientos',
    nombreEn: 'Galvanizing & coatings',
    desc: 'Zinc y aleaciones para protección anticorrosiva.',
    descEn: 'Zinc and alloys for anti-corrosion protection.',
    icon: 'shield',
    img: '/assets/img/galvanizado.jpg',
  },
  {
    nombre: 'Minería',
    nombreEn: 'Mining',
    desc: 'Compra y procesamiento de minerales y subproductos.',
    descEn: 'Purchase and processing of minerals and by-products.',
    icon: 'mountain',
    img: '/assets/img/mineria.jpg',
  },
  {
    nombre: 'Energía y baterías',
    nombreEn: 'Energy & batteries',
    desc: 'Materias primas para celdas y soluciones de almacenamiento.',
    descEn: 'Raw materials for cells and storage solutions.',
    icon: 'battery',
    img: '/assets/img/energia.jpg',
  },
];

const icons: Record<string, string> = {
  car: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 13l1.5-4.5A2 2 0 0 1 6.4 7h11.2a2 2 0 0 1 1.9 1.5L21 13"/><rect x="3" y="13" width="18" height="5" rx="1.5"/><circle cx="7.5" cy="18.5" r="1.5"/><circle cx="16.5" cy="18.5" r="1.5"/></svg>',
  building: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 21V7l8-4 8 4v14"/><path d="M4 21h16"/><path d="M9 9h.01M9 13h.01M9 17h.01M15 9h.01M15 13h.01M15 17h.01"/></svg>',
  chip: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="6" width="12" height="12" rx="1.5"/><path d="M9 2v3M15 2v3M9 19v3M15 19v3M2 9h3M2 15h3M19 9h3M19 15h3"/></svg>',
  shield: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3Z"/></svg>',
  mountain: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 19 9 8l4 6 2-3 6 8Z"/></svg>',
  battery: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="8" width="17" height="8" rx="1.5"/><path d="M22 10.5v3"/><path d="M7 11v2M11 11v2M15 11v2"/></svg>',
};
---
<section class="products dark-section tech-grid tech-grid-dark" id="industrias">
  <div class="container">
    {showEyebrow && <span class="eyebrow reveal" data-i18n="industrias.eyebrow">Industrias</span>}
    <h2 class="reveal" data-i18n="industrias.title">Respaldamos a industrias de distintos sectores</h2>
    <p class="section-lead reveal" style="--d:1" data-i18n="industrias.body">Con soluciones a la medida y volumen consistente, desarrollando las aleaciones y formulaciones específicas que cada operación requiere.</p>

    <div class="industria-grid">
      {sectores.map((s, i) => (
        <div class="industria-card reveal" style={`--d:${(i % 3) + 1}; background-image: url('${s.img}')`}>
          <span class="industria-card-icon" aria-hidden="true" set:html={icons[s.icon]} />
          <div class="industria-card-body">
            <h3 data-i18n-es={s.nombre} data-i18n-en={s.nombreEn}>{s.nombre}</h3>
            <p data-i18n-es={s.desc} data-i18n-en={s.descEn}>{s.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
